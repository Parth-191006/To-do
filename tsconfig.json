{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts"],
  // `scripts/` holds Node-only tooling (run via `npm run verify:nlp`), which
  // uses node: builtins and .ts import specifiers the app config doesn't need.
  "exclude": ["node_modules", "dist", ".expo", "scripts"]
}
